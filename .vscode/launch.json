{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Edge with ASP.NET Core",
            "type": "msedge",
            "request": "launch",
            "preLaunchTask": "build",
            "url": "http://localhost:7056/Inventory/Add",
            "webRoot": "${workspaceFolder}",
            "sourceMapPathOverrides": {
                "https://localhost:7056/*": "${workspaceFolder}/*"
            }
        },
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/MyMvcApp.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "serverReadyAction": {
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ],
    "compounds": [
        {
            "name": "ASP.NET Core & Browser Debug",
            "configurations": [".NET Core Launch (web)", "Launch Edge with ASP.NET Core"]
        }
    ]
}

