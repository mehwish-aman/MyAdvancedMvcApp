@model List<InventoryItem>
<style>
    body {
        background-color: white;
        font-family: Arial, sans-serif;
        padding: 40px;
        min-height: 100vh;
        box-sizing: border-box;
        margin: 0;
    }
    #inventoryForm {
    display: flex;
    flex-direction: column;
    flex: 1;
}
    .form-box {
    background-color: white;
    padding: 30px 40px;
    border-radius: 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    border: 1px solid #ccc;
    width: 98%;
    min-height: 270px;   /* box ki minimum height, apni pasand se adjust kar sakti ho */
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}
    .form-box h2 {
        margin-top: 0;
        margin-bottom: 20px;
    }
    .form-grid {
       display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 30px;
    row-gap: 18px;
    width: 100%; 
    }
    .field-group {
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        gap: 4px;
    }
    .field-group label {
        /*font-weight;*/
        font-size: 16px;
    }
    .field-group input {
        padding: 10px;
        border: 1px solid grey;
        border-radius: 5px;
        box-sizing: border-box;
        background-color: rgba(252, 250, 250, 0.973);
        width:100%;
    }
    .save-row {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
    }
    .save-row button {
        padding: 10px 30px;
        background-color: #0d5ed8;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
    }
    
    .table-box {
    margin-top: 40px;
    background-color: white;
    padding: 30px 40px;
    border-radius: 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    border: 1px solid #ccc;
    width: 98%;
    box-sizing: border-box;
}
    .inventory-table {
        width: 100%;
        border-collapse: collapse;
    }
    .inventory-table th, .inventory-table td {
        padding: 10px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }
    .inventory-table th {
        background-color: #f0f0f0;
        font-weight: bold;
    }

    /* Modal overlay */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        justify-content: center;
        align-items: center;
        z-index: 999;
    }
    .modal-box {
        background-color: white;
        padding: 25px;
        border-radius: 10px;
        text-align: center;
        width: 280px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .modal-box p {
        font-weight: bold;
        margin-bottom: 20px;
    }
    .modal-buttons {
        display: flex;
        justify-content: space-evenly;
    }
    .btn-yes {
        background-color: #18794c;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 15px;
    }
    .btn-no {
        background-color: #c52131;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 15px;
    }
    .page-title {
    margin: 0 0 20px 0;
}

    #messageBox {
        display: none;
        margin-left: 500px;
        padding: 10px 20px;
        background-color:#192b87;
        color: white;
        border-radius: 5px;
        text-align: center;
        width: fit-content;
        max-width:400px;
    }
    .check-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 15px;
}
</style>
<h2 class="page-title" >Add Inventory Item</h2>
<div class="form-box">
    <form method="post" action="/Inventory/Save" id="inventoryForm">
        <div class="form-grid">
            <div class="field-group">
                <label>Item Name  <span style="color:red;">*</span></label>
                <input type="text" name="ItemName" maxlength="100" required />
            </div>
            <div class="field-group">
                <label>Description</label>
                <input type="text" name="Description" maxlength="250" />
            </div>

            <div class="field-group">
                <label>Purchase Value  <span style="color:red;">*</span></label>
                <input type="number" step="0.01" id="PurchaseValue" name="PurchaseValue" placeholder="0" required />
            </div>
            <div class="field-group">
                <label>Purchase Date  <span style="color:red;">*</span></label>
                <input type="date" name="PurchaseDate" required />
            </div>

            <div class="field-group">
                <label>Tax  <span style="color:red;">*</span></label>
                <input type="number" step="0.01" id="tax" name="Tax" placeholder="0" required />
            </div>
            <div class="field-group">
                <label>Total</label>
                <input type="number" step="0.01" id="total" name="Total" placeholder="0" readonly />
            </div>

            <div class="field-group">
                <label>Company  <span style="color:red;">*</span></label>
                <input type="text" name="Company" maxlength="100" required />
            </div>
        </div>
        <div id="validationError" style="display:none; color:#dc3545; font-weight:bold; margin-top:15px;"></div>

        <div class="save-row">
            <button type="button" id="saveBtn">Save</button>
        </div>

        <div id="messageBox"></div>
    </form>
</div>


<div class="table-box">
    <h2 xclass ="page-title">Inventory List</h2>
    <table class="inventory-table">
        <thread>
            <tr>
                <th>Item Name</th>
                <th>Description</th>
                <th>Purchase Value</th>
                <th>Purchase Date</th>
                <th>Tax %</th>
                <th>Total</th>
                <th>Company</th>
                <th>Action</th>
            </tr>
        </thread>
        <tbody id="inventoryTableBody">
            @foreach (var item in Model)
            {
                <tr id="row-@item.Id">
                    <td>@item.ItemName</td>
                    <td>@item.Description</td>
                    <td>@item.PurchaseValue</td>
                    <td>@item.PurchaseDate.ToShortDateString()</td>
                    <td>@item.Tax</td>
                    <td>@item.Total</td>
                    <td>@item.Company</td>
                    <td>
                        <button type="button" class="delete-btn" data-id="@item.Id">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal / Popup -->
<div class="modal-overlay" id="confirmModal">
    <div class="modal-box">
         <div class="check-icon">
            <svg viewBox="0 0 52 52" width="60" height="60">
                <circle cx="26" cy="26" r="25" fill="#198754"/>
                <path fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" d="M14 27l7 7 16-16"/>
            </svg>
        </div>
        <p>Are you sure you want to save?</p>
        <div class="modal-buttons">
            <button class="btn-no" id="noBtn">No</button>
            <button class="btn-yes" id="yesBtn">Yes</button>
        </div>
    </div>
</div>


<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <div class="check-icon">
            <svg viewBox="0 0 52 52" width="60" height="60">
                <circle cx="26" cy="26" r="25" fill="#dc3545"/>
                <path fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" d="M17 17l18 18M35 17l-18 18"/>
            </svg>
        </div>
        <p>Are you sure you want to delete this item?</p>
        <div class="modal-buttons">
            <button class="btn-no" id="cancelDeleteBtn">No</button>
            <button class="btn-yes" id="confirmDeleteBtn">Yes</button>
        </div>
    </div>
</div>
<script>
    const purchaseValueInput = document.getElementById("PurchaseValue");
    const taxInput = document.getElementById("tax");
    const totalInput = document.getElementById("total");

    function calculateTotal() {
    const purchaseValue = parseFloat(purchaseValueInput.value) || 0;
    const taxPercent = parseFloat(taxInput.value) || 0;
    const taxAmount = (purchaseValue * taxPercent) / 100;
    totalInput.value = (purchaseValue + taxAmount).toFixed(2);
}
// Numeric fields ko max 6 digits tak limit karo
    function limitNumberInput(inputElement, maxDigits) {
    inputElement.addEventListener("input", function () {
        if (this.value.length > maxDigits) {
            this.value = this.value.slice(0, maxDigits);
        }
        });
       }

      limitNumberInput(purchaseValueInput, 6);
     limitNumberInput(taxInput, 6);

    purchaseValueInput.addEventListener("input", calculateTotal);
    taxInput.addEventListener("input", calculateTotal);

    // Modal logic
    const saveBtn = document.getElementById("saveBtn");
    const modal = document.getElementById("confirmModal");
    const yesBtn = document.getElementById("yesBtn");
    const noBtn = document.getElementById("noBtn");
    const form = document.getElementById("inventoryForm");
    const messageBox = document.getElementById("messageBox");
    saveBtn.addEventListener("click", function () {
    if (form.checkValidity()) {
        validationError.style.display = "none";
        modal.style.display = "flex";
    } else {
        validationError.innerText = "Please fill in all required fields before saving.";
        validationError.style.display = "block";
        form.reportValidity(); // browser ke apne error bubbles bhi dikhayega har field ke paas
    }
});

    noBtn.addEventListener("click", function () {
        modal.style.display = "none";
        form.reset();
        totalInput.value = "";
    });

    yesBtn.addEventListener("click", function () {
    const formData = new FormData(form);

    fetch(form.action, {
        method: "POST",
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        modal.style.display = "none";
        messageBox.innerText = data.message;
        messageBox.style.display = "block";

        // Naya row table mein add karo
        const tableBody = document.getElementById("inventoryTableBody");
        const newRow = document.createElement("tr");
        newRow.id = "row-" + data.id;
        newRow.innerHTML = `
            <td>${data.itemName}</td>
            <td>${data.description}</td>
            <td>${data.purchaseValue}</td>
            <td>${data.purchaseDate}</td>
            <td>${data.tax}</td>
            <td>${data.total}</td>
            <td>${data.company}</td>
            <td><button type="button" class="delete-btn" data-id="${data.id}">🗑️</button></td>
        `;
        tableBody.prepend(newRow);

        // Naye delete button ko bhi event listener do
        newRow.querySelector(".delete-btn").addEventListener("click", function () {
            itemIdToDelete = this.getAttribute("data-id");
            deleteModal.style.display = "flex";
        });

        form.reset();
        totalInput.value = "0";
    })
    .catch(error => {
        modal.style.display = "none";
        messageBox.innerText = "Something went wrong!";
        messageBox.style.display = "block";
    });
});  



//delete button logic javascript
// Delete logic
const deleteModal = document.getElementById("deleteModal");
const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");
let itemIdToDelete = null;

// Saare delete buttons ko event listener do
document.querySelectorAll(".delete-btn").forEach(function (button) {
    button.addEventListener("click", function () {
        itemIdToDelete = this.getAttribute("data-id");
        deleteModal.style.display = "flex";
    });
});

cancelDeleteBtn.addEventListener("click", function () {
    deleteModal.style.display = "none";
    itemIdToDelete = null;
});

confirmDeleteBtn.addEventListener("click", function () {
    if (itemIdToDelete) {
        fetch("/Inventory/Delete/" + itemIdToDelete, {
            method: "POST"
        })
        .then(response => response.json())
        .then(data => {
            deleteModal.style.display = "none";
            const row = document.getElementById("row-" + itemIdToDelete);
            if (row) {
                row.remove();
            }
        })
        .catch(error => {
            deleteModal.style.display = "none";
            alert("Something went wrong while deleting.");
        });
    }
});
</script>