<style>
    body {
        background-color: white;
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
    }
    .form-box {
        background-color: white;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        width: 600px;
        position: relative;
        background-color: #c4bebe;
    }
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr; /* do equal columns */
        gap: 0 20px; /* rows ke beech 0, columns ke beech 20px space */
    }
    .form-box input {
        width: 100%;
        padding: 8px;
        margin: 6px 0 14px 0;
        border: 1px solid #999;
        border-radius: 5px;
        box-sizing: border-box;
    }
    .form-box label {
        font-weight: bold;
        font-size: 14px;
    }
    .form-box button {
        width: 100%;
        padding: 10px;
        background-color: #0d6efd;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
        margin-top: 10px;
    }

    /* Modal overlay */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        justify-content: center;
        align-items: center;
        z-index: 999;
    }
    .modal-box {
        background-color: white;
        padding: 25px;
        border-radius: 10px;
        text-align: center;
        width: 280px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .modal-box p {
        font-weight: bold;
        margin-bottom: 20px;
    }
    .modal-buttons {
        display: flex;
        justify-content: space-between;
    }
    .btn-yes {
        background-color: #198754;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 15px;
    }
    .btn-no {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 15px;
    }
</style>

<div class="form-box">
    <h2>Add Inventory Item</h2>
    <form method="post" action="/Inventory/Save" id="inventoryForm">
        <div class="form-grid">
            <div>
                <label>Item Name</label>
                <input type="text" name="ItemName" required />
            </div>
            <div>
                <label>Description</label>
                <input type="text" name="Description" />
            </div>

            <div>
                <label>Purchase Value</label>
                <input type="number" step="0.01" id="PurchaseValue" name="PurchaseValue" required />
            </div>
            <div>
                <label>Purchase Date</label>
                <input type="date" name="PurchaseDate" required />
            </div>

            <div>
                <label>Tax</label>
                <input type="number" step="0.01" id="tax" name="Tax" required />
            </div>
            <div>
                <label>Total (Auto-Calculated)</label>
                <input type="number" step="0.01" id="total" name="Total" readonly />
            </div>

            <div>
                <label>Company</label>
                <input type="text" name="Company" required />
            </div>
        </div>

        <button type="button" id="saveBtn">Save</button>
    </form>
    <div id="messageBox" style="display:none; margin-top:15px; 
    padding:10px; background-color:#d4edda; color:#155724; border-radius:5px; 
    text-align:center; grid-column: 1 / -1;"></div>
</div>

<!-- Modal / Popup -->
<div class="modal-overlay" id="confirmModal">
    <div class="modal-box">
        <p>Are you sure you want to save?</p>
        <div class="modal-buttons">
            <button class="btn-yes" id="yesBtn">Yes</button>
            <button class="btn-no" id="noBtn">No</button>
        </div>
    </div>
</div>

<script>
    const purchaseValueInput = document.getElementById("PurchaseValue");
    const taxInput = document.getElementById("tax");
    const totalInput = document.getElementById("total");

    function calculateTotal() {
        const purchaseValue = parseFloat(purchaseValueInput.value) || 0;
        const tax = parseFloat(taxInput.value) || 0;
        totalInput.value = (purchaseValue + tax).toFixed(2);
    }

    purchaseValueInput.addEventListener("input", calculateTotal);
    taxInput.addEventListener("input", calculateTotal);

  // Modal logic
const saveBtn = document.getElementById("saveBtn");
const modal = document.getElementById("confirmModal");
const yesBtn = document.getElementById("yesBtn");
const noBtn = document.getElementById("noBtn");
const form = document.getElementById("inventoryForm");
const messageBox = document.getElementById("messageBox");

saveBtn.addEventListener("click", function () {
    modal.style.display = "flex";
});

noBtn.addEventListener("click", function () {
    modal.style.display = "none";
    // form.reset(); // form ke saare fields khali kar do
    //totalInput.value = ""; // Total ko bhi explicitly clear kiya, safe rehne ke liye
});

yesBtn.addEventListener("click", function () {
    const formData = new FormData(form);

    fetch(form.action, {
        method: "POST",
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        modal.style.display = "none";
        messageBox.innerText = data.message;
        messageBox.style.display = "block";
    })
    .catch(error => {
        modal.style.display = "none";
        messageBox.innerText = "Something went wrong!";
        messageBox.style.display = "block";
    });
});
</script>