<style>    /*styling yahna hogi means page body, login box, inputs ka style sb kuch yahan mention hoga*/
    body {
        background-color: white;
        margin: 0;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items:center;
        font-family: arial,sans-serif;
    }
    .login-box{
        background-color: darkslateblue;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0, 0, alpha);
        width: 300px;
        text-align: center;
        }

        .login-box h2
        {
            margin-bottom: 20px;
            color: ghostwhite;
        }

        .login-box input
        {
            width: 100%;
            padding: 10px;
            margin: 8px 0;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
        }

        .login-box button
        {
            width:100px;
            padding: 10px;
            margin-top: 10px;
            background-color: lavender;
            color: darkslategrey;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }
        .error-msg
        {
            color: red;
            margin-bottom: 10px;
        }
</style>

<div class="login-box">    <!--sari html yahna aygei UI sari yahan par likheingy hum wahi style mein jo classes likhin thin
    unko use krty huye-->
    <h2>Login</h2>   

<!-- yeh  validation check hai kay ager error aya haito kya ho -->
    @if (ViewBag.Error !=null)   
    {
        <p class="error-msg">@ViewBag.Error</p>   <!--   yeh controller mein jaygea r error message print kr dega  -->
    } 
<!--         -->
    <!-- Explaination:
    form submit hotey hi browser full page reload krky pst req bhejy ga. dono values same url py jaingin /Account/Login py.
    Account controller ka [httppost login method inhein catch krta hai aur credentials ko validate karta hai-->

    <form method="post">      <!--   submit honay kay bd data kesy server ko jayega post req means  url mein hide krky jayega, agr get hota means
        url mein show hota -->

        <!--  when form submit, asp.net model binding kryga ky isy 
        loginmodel class ki property mein dal dega (match krna zarorri hai) -->
        <input type="text" name="Username" placeholder="Username"/> 
        <input type="password" name="password" placeholder="Password" /> <!--placeholder-visual hint hai bs-->
        <button type="submit">Login</button>   
    </form>
</div>
        